{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "description": "An object to hold a set of reusable objects for different aspects of the AsyncAPI Specification.",
  "additionalProperties": false,
  "properties": {
    "schemas": {
      "$ref": "./components/schemas.json"
    },
    "messages": {
      "$ref": "./components/messages.json"
    },
    "securitySchemes": {
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "oneOf": [
            {
              "$ref": "./fragments/reference.json"
            },
            {
              "$ref": "./components/securitySchemes.json"
            }
          ]
        }
      }
    },
    "parameters": {
      "$ref": "./components/parameters.json"
    },
    "correlationIds": {
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "oneOf": [
            {
              "$ref": "./fragments/reference.json"
            },
            {
              "$ref": "./components/correlationIds.json"
            }
          ]
        }
      }
    },
    "operationTraits": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./components/operationTraits.json"
      }
    },
    "messageTraits": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./components/messageTraits.json"
      }
    },
    "serverBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./fragments/bindingsObject.json"
      }
    },
    "channelBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./fragments/bindingsObject.json"
      }
    },
    "operationBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./fragments/bindingsObject.json"
      }
    },
    "messageBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./fragments/bindingsObject.json"
      }
    }
  }
}
