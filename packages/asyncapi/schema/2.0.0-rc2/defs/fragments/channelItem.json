{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": {
      "$ref": "./specificationExtension.json"
    }
  },
  "minProperties": 1,
  "properties": {
    "$ref": {
      "$ref": "./referenceObject.json"
    },
    "parameters": {
      "$ref": "../components/parameters.json"
    },
    "description": {
      "type": "string",
      "description": "A description of the channel."
    },
    "publish": {
      "$ref": "./operation.json"
    },
    "subscribe": {
      "$ref": "./operation.json"
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "bindings": {
      "$ref": "./bindingsObject.json"
    }
  }
}
