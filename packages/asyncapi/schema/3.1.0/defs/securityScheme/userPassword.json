  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "userPassword"
      ]
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": {
