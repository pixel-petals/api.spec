{
  "$schema": "http://json-schema.org/draft-07/schema",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "../fragments/reference.json"
  },
  "else": {
    "description": "Allows adding metadata to a single tag.",
    "type": "object",
    "required": [
      "name"
    ],
    "properties": {
      "description": {
        "description": "A short description for the tag. CommonMark syntax can be used for rich text representation.",
        "type": "string"
      },
      "externalDocs": {
        "oneOf": [
          {
            "$ref": "../fragments/reference.json"
          },
          {
            "$ref": "./externalDocs.json"
          }
        ]
      },
      "name": {
        "description": "The name of the tag.",
        "type": "string"
      }
    },
    "patternProperties": {
      "^x-[\\w\\d\\.\\x2d_]+$": {
        "$ref": "../fragments/specificationExtension.json"
      }
    },
    "additionalProperties": false,
    "examples": [
      {
        "name": "user",
        "description": "User-related messages"
      }
    ]
  }
}
