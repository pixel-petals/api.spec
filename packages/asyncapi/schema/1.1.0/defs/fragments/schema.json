    "allOf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./schema.json"
      }
    },
    "oneOf": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "./schema.json"
      }
    },
    "anyOf": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "./schema.json"
      }
    },
    "not": {
      "$ref": "./schema.json"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./schema.json"
      },
      "default": {}
    },
    "discriminator": {
      "type": "string"
    },
    "readOnly": {
      "type": "boolean",
      "default": false
    },
    "xml": {
      "$ref": "./xml.json"
    },
    "externalDocs": {
      "$ref": "../externalDocs.json"
