    "uniqueItems": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "maxProperties": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "minProperties": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "required": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "enum": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "additionalProperties": {
      "anyOf": [
        {
          "$ref": "./schema.json"
        },
        {
          "type": "boolean"
        }
      ],
      "default": {}
    },
    "type": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "items": {
      "anyOf": [
        {
          "$ref": "./schema.json"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./schema.json"
          }
        }
      ],
      "default": {}
