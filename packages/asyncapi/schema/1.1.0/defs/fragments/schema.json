  "description": "A deterministic version of a JSON Schema object.",
  "patternProperties": {
    "^x-": {
      "$ref": "./vendorExtension.json"
    }
  },
  "properties": {
    "$ref": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "title": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "description": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "default": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "multipleOf": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "maximum": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "exclusiveMaximum": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "minimum": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "exclusiveMinimum": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "maxLength": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "minLength": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "pattern": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "maxItems": {
      "$ref": "./jsonSchemaDraft07Schema.json"
    },
    "minItems": {
      "$ref": "./jsonSchemaDraft07Schema.json"
