{
  "$schema": "http://json-schema.org/draft-07/schema",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "../fragments/server.json"
  },
  "else": {
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
      "^x-[\\w\\d\\.\\x2d_]+$": {
        "$ref": "../fragments/specificationExtension.json"
      }
    },
    "properties": {
      "summary": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "$ref": "../tags/tag.json"
        },
        "uniqueItems": true
      },
      "externalDocs": {
        "$ref": "../externalDocs.json"
      },
      "operationId": {
        "type": "string"
      },
      "bindings": {
        "$ref": "../fragments/bindingsObject.json"
      }
    }
  }
}
