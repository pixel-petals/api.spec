{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A response to a request that indicates an error occurred.",
  "properties": {
    "error": {
      "$ref": "./error.json"
    },
    "id": {
      "$ref": "./requestId.json"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    }
  },
  "required": [
    "error",
    "jsonrpc"
  ],
  "type": "object"
}
