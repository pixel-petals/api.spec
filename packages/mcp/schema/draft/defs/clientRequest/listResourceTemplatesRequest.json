{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sent from the client to request a list of resource templates the server has.",
  "properties": {
    "id": {
      "$ref": "../fragments/requestId.json"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "const": "resources/templates/list",
      "type": "string"
    },
    "params": {
      "$ref": "../fragments/paginatedRequestParams.json"
    }
  },
  "required": [
    "id",
    "jsonrpc",
    "method",
    "params"
  ],
  "type": "object"
}
