{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A successful response from the server for a {@link GetPromptRequestprompts/get} request.",
  "properties": {
    "id": {
      "$ref": "./requestId.json"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "../serverResult/inputRequiredResult.json"
        },
        {
          "$ref": "../serverResult/getPromptResult.json"
        }
      ]
    }
  },
  "required": [
    "id",
    "jsonrpc",
    "result"
  ],
  "type": "object"
}
