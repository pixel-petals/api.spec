{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Used by the client to invoke a tool provided by the server.",
  "properties": {
    "id": {
      "$ref": "../fragments/requestId.json"
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "const": "tools/call",
      "type": "string"
    },
    "params": {
      "$ref": "../fragments/callToolRequestParams.json"
    }
  },
  "required": [
    "id",
    "jsonrpc",
    "method",
    "params"
  ],
  "type": "object"
}
