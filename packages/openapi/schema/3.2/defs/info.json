{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "https://spec.openapis.org/oas/v3.2#info-object",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "termsOfService": {
      "type": "string",
      "format": "uri-reference"
    },
    "contact": {
      "$ref": "./fragments/contact.json"
    },
    "license": {
      "$ref": "./fragments/license.json"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "version"
  ],
  "$ref": "../schema.json#/$defs/specification-extensions",
  "unevaluatedProperties": false
}
