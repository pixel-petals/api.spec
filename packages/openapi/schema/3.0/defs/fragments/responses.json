{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "default": {
      "oneOf": [
        {
          "$ref": "../components/responses.json"
        },
        {
          "$ref": "./reference.json"
        }
      ]
    }
  },
  "patternProperties": {
    "^[1-5](?:\\d{2}|XX)$": {
      "oneOf": [
        {
          "$ref": "../components/responses.json"
        },
        {
          "$ref": "./reference.json"
        }
      ]
    },
    "^x-": {}
  },
  "minProperties": 1,
  "additionalProperties": false
}
