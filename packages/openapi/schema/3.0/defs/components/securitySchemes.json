{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "../fragments/reference.json"
  },
  "else": {
    "oneOf": [
      {
        "$ref": "../securityScheme/apiKeySecurityScheme.json"
      },
      {
        "$ref": "../securityScheme/httpSecurityScheme.json"
      },
      {
        "$ref": "../securityScheme/oAuth2SecurityScheme.json"
      },
      {
        "$ref": "../securityScheme/openIdConnectSecurityScheme.json"
      }
    ]
  }
}
