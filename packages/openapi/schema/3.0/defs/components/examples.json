{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "../fragments/reference.json"
  },
  "else": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "value": {},
      "externalValue": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "patternProperties": {
      "^x-": {}
    },
    "additionalProperties": false
  }
}
