{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "../fragments/reference.json"
  },
  "else": {
    "type": "object",
    "required": [
      "content"
    ],
    "properties": {
      "description": {
        "type": "string"
      },
      "content": {
        "type": "object",
        "additionalProperties": {
          "$ref": "../fragments/mediaType.json"
        }
      },
      "required": {
        "type": "boolean",
        "default": false
      }
    },
    "patternProperties": {
      "^x-": {}
    },
    "additionalProperties": false
  }
}
