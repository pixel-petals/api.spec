{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "../fragments/reference.json"
  },
  "else": {
    "$comment": "https://spec.openapis.org/oas/v3.1#link-object",
    "type": "object",
    "properties": {
      "operationRef": {
        "type": "string",
        "format": "uri-reference"
      },
      "operationId": {
        "type": "string"
      },
      "parameters": {
        "$ref": "../fragments/mapOfStrings.json"
      },
      "requestBody": true,
      "description": {
        "type": "string"
      },
      "server": {
        "$ref": "../servers/server.json"
      }
    },
    "oneOf": [
      {
        "required": [
          "operationRef"
        ]
      },
      {
        "required": [
          "operationId"
        ]
      }
    ],
    "$ref": "../../schema.json#/$defs/specification-extensions",
    "unevaluatedProperties": false
  }
}
