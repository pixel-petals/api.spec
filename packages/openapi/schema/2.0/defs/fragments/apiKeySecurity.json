{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "name",
    "in"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "apiKey"
      ]
    },
    "name": {
      "type": "string"
    },
    "in": {
      "type": "string",
      "enum": [
        "header",
        "query"
      ]
    },
    "description": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^x-": {
      "$ref": "./vendorExtension.json"
    }
  }
}
