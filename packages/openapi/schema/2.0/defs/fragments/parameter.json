{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "if": {
    "type": "object",
    "required": [
      "$ref"
    ]
  },
  "then": {
    "$ref": "./response.json"
  },
  "else": {
    "oneOf": [
      {
        "$ref": "../parameter/bodyParameter.json"
      },
      {
        "$ref": "../parameter/nonBodyParameter.json"
      }
    ]
  }
}
